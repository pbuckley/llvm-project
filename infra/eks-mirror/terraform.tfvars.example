# This is an ARN, not the token value. The secret must be in aws_region and
# contain JSON shaped as {"BUILDKITE_AGENT_TOKEN":"bkct_..."}.
buildkite_agent_token_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:buildkite/llvm-eks-agent-token-abc123"

# Restrict the public EKS API endpoint to the operator's address for the demo.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

tags = {
  Owner = "solutions-engineering"
}
